<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo">
          <span class="logo-cafod">CAF<span class="logo-o">O</span>D</span>
          <div class="logo-text">
            <span>Catholic international</span>
            <span>development charity</span>
          </div>
        </div>
        <p class="brand-desc">CAFOD is the official aid agency of the Catholic Church in England and Wales and part of Caritas Internationalis.</p>
        <div class="social-links">
          <a href="#" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="#" aria-label="Twitter"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg></a>
          <a href="#" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
          <a href="#" aria-label="YouTube"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg></a>
        </div>
      </div>

      <div class="footer-links">
        <div class="link-column">
          <h4 class="col-title">WHAT WE DO</h4>
          <ul>
            <li><a href="#">Our work overseas</a></li>
            <li><a href="#">Emergencies</a></li>
            <li><a href="#">Climate change</a></li>
            <li><a href="#">Policy and research</a></li>
            <li><a href="#">Peace building</a></li>
          </ul>
        </div>
        <div class="link-column">
          <h4 class="col-title">GET INVOLVED</h4>
          <ul>
            <li><a href="#">Donate</a></li>
            <li><a href="#">Fundraise</a></li>
            <li><a href="#">Volunteer</a></li>
            <li><a href="#">Campaign</a></li>
            <li><a href="#">Leave a gift in your will</a></li>
          </ul>
        </div>
        <div class="link-column">
          <h4 class="col-title">ABOUT CAFOD</h4>
          <ul>
            <li><a href="#">Our structure</a></li>
            <li><a href="#">Transparency</a></li>
            <li><a href="#">Catholic Social Teaching</a></li>
            <li><a href="#">Work with us</a></li>
            <li><a href="#">Resources</a></li>
          </ul>
        </div>
        <div class="link-column">
          <h4 class="col-title">MORE</h4>
          <ul>
            <li><a href="#">News & stories</a></li>
            <li><a href="#">Education</a></li>
            <li><a href="#">Shop</a></li>
            <li><a href="#">Press</a></li>
            <li><a href="#">Contact us</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>CAFOD is a registered charity in England and Wales (1160384) and a company limited by guarantee (09387398). Registered office: Romero House, 55 Westminster Bridge Road, London SE1 7JB.</p>
      <div class="bottom-links">
        <a href="#">Privacy policy</a>
        <a href="#">Terms & conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--c-navy);
    color: var(--c-white);
    padding: 5rem 0 2rem 0;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 300px 1fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-cafod {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--c-primary);
  }
  
  .logo-o {
    color: var(--c-white);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    border-left: 1px solid rgba(255,255,255,0.2);
    padding-left: 0.75rem;
  }

  .brand-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.7);
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.1);
    color: var(--c-white);
    transition: background 0.2s;
  }

  .social-links a:hover {
    background-color: var(--c-primary);
    color: var(--c-navy);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-links {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .col-title {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--c-primary);
    margin-bottom: 1.25rem;
    letter-spacing: 0.5px;
  }

  .link-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-column a {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
    transition: color 0.2s;
  }

  .link-column a:hover {
    color: var(--c-white);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .bottom-links a {
    transition: color 0.2s;
  }

  .bottom-links a:hover {
    color: var(--c-white);
  }
</style>
